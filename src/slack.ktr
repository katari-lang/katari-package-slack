// The Slack library: a Socket Mode connection capability plus the watch / send agents, the Slack twin
// of the Discord package. The externals are implemented in `slack.ts` (the same module path, so they
// register under `slack.*`). The one-line integration is the provider:
// `use slack.provider(bot_source = credentials.env(key = "SLACK_BOT_TOKEN"), app_source = credentials.env(key = "SLACK_APP_TOKEN"))`.
//
// Socket Mode needs no public URL and no request-signature verification: the sidecar opens an outbound
// WebSocket with the app-level token (`xapp-…`) and Slack pushes events over it, while the bot token
// (`xoxb-…`) drives the Web API (posting, uploads, attachment downloads). Both tokens stay inside the
// sidecar, keyed by the opaque client handle — they are never served as a value.
//
// Files are first-class on both directions: an incoming message's attachments arrive as `file` values
// (the sidecar downloads each from Slack's authenticated file URL and uploads it over the blob side
// channel), and `send_message` posts `file` values back as Slack uploads (`files.uploadV2`).

@"The live Slack connection (the Socket Mode and Web API clients live in the sidecar; the handle is
opaque)."
request connection() -> string

@"Provide the Slack connection for the extent of the continuation: resolve the two sources ONCE (a
socket credential is fixed at connect — a rotation lands on the next restart, not mid-connection),
connect over Socket Mode, then serve `connection` to everything downstream. A failed connect (a bad
`xapp-…` token, a transient network fault) raises `slack_error` (`auth_error` | `api_error`) —
surfacing here rather than on the first send. Slack genuinely takes TWO credentials, so there are two
sources: the bot token (`xoxb-…`, the Web API) and the app-level token (`xapp-…`, the socket)."
agent provider[R, effect E](
  @"Where the bot token (`xoxb-…`) lives; resolved once at connect." bot_source: credentials.source,
  @"Where the app-level token (`xapp-…`) lives; resolved once at connect." app_source: credentials.source,
  @"Runs with `connection` served; its result is the provider's result." continuation: agent (value: null) -> R with {...E, connection},
) -> R with E | io | prelude.throw[slack_error | env.missing_secret | oauth.server_error] {
  let client = create_slack_client(bot_token = credentials.resolve(source = bot_source), app_token = credentials.resolve(source = app_source))
  // Bind the socket's lifetime to this run: however the provider ends — normal completion, cancel, or
  // the continuation unwinding — close the connection on the way out. A socket left open keeps
  // receiving events, and Slack round-robins each event across every socket open on the app token, so a
  // dead run's zombie socket would swallow messages (acking them) that a live bot then never sees.
  finally { slack_close(client = client) }
  use handler {
    request connection() { next client }
  }
  continuation(value = null)
}

@"Connect to Slack — open the Socket Mode WebSocket and the Web API client — and return an opaque
client handle. Raises `slack_error` (`auth_error` | `api_error`) when the connect fails — a bad
app-level token is `auth_error`, a transient network fault `api_error`. Prefer the provider."
external agent create_slack_client(
  @"The bot token (`xoxb-…`) every Web API call authenticates with." bot_token: string of private,
  @"The app-level token (`xapp-…`) the Socket Mode WebSocket opens with." app_token: string of private,
) -> string with prelude.throw[slack_error]

@"Close a Slack connection: disconnect the Socket Mode WebSocket and drop the client handle. The
provider arms this as a `finally`, so the connection dies with the run — a socket left open keeps
receiving events, and Slack round-robins each event across every socket open on the app token, so a
dead run's zombie socket would swallow messages (acking them) that a live bot then never sees.
Idempotent: closing an unknown or already-closed handle is a no-op, since a finalizer may run more
than once."
external agent slack_close(
  @"The opaque handle `create_slack_client` returned." client: string,
) -> null

@"An authentication / authorization failure: the bot token is invalid, revoked, or missing a scope the
call needs (Slack `invalid_auth`, `token_revoked`, `missing_scope`, …); @message@ carries Slack's error
string. The bot cannot recover on its own — the operator must fix the token or scopes and restart the
run (the connection is fixed at start). Let it surface so the bot stops loudly rather than silently
dropping every reply."
data auth_error(message: string)

@"A Slack API call failed for a non-auth reason: a rate limit, a transient network fault, a channel the
bot is not in, a message too long; @message@ carries Slack's error string. Usually per-message or
transient, so a bot catches it to drop just that reply and keep serving."
data api_error(message: string)

// A Slack send failure: an auth/authorization failure or a plain API failure. Raised as a
// `prelude.throw` (never a panic — that would tear the whole run down), classified in the sidecar by
// Slack's error code. (Type synonyms take no docs.)
type slack_error = auth_error | api_error

@"Low-level: post to a channel on a given client — a thread reply when @thread_ts@ carries a `ts`, a
channel post when it is `null`; any files upload as attachments — returning the posted message's `ts`
(a plain post's own `ts`, a file upload's share `ts`, or `\"\"` when Slack reports none). Raises
`auth_error` or `api_error` (`slack_error`) when the Slack API call fails. Prefer the send_message agent."
external agent slack_send(
  @"The opaque handle `create_slack_client` returned." client: string,
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text (Slack mrkdwn); with files it becomes their caption." text: string,
  @"The parent message's `ts` to reply in its thread, or `null` to post to the channel." thread_ts: string | null,
  @"Files to upload as the message's attachments (`[]` for a plain text post)." files: array[file],
) -> string with prelude.throw[slack_error]

@"Post @prompt@ with one Block Kit BUTTON per option to a channel and BLOCK until someone there clicks
one, returning the clicked label verbatim — the built-in human-approval UI (an `ai.authorize_monitor`
provider asking an operators' channel, a confirmation step before an irreversible action). Put the
prompt in a channel whose MEMBERSHIP is the trust boundary: any member may click. The wait rides one
external call, so a runtime restart while it is open interrupts it under the at-most-once rule (a
catchable panic) and the posted buttons go stale. That failure is the DESIGNED outcome, not a defect
to absorb here: let the panic ride to your supervisor and restart the asking flow — whoever wanted the
answer asks again — rather than guessing an answer for a click that never landed. Raises `slack_error`
when the post fails."
agent ask(
  @"The id of the channel to ask in — its membership is who may answer." channel: string,
  @"The question posted above the buttons." prompt: string,
  @"One button label per option; the clicked label is returned." options: array[string],
) -> string {
  slack_ask(client = connection(), channel = channel, prompt = prompt, options = options)
}

@"Low-level: post a Block Kit button prompt on a given client and await the click. Prefer the ask agent."
external agent slack_ask(
  @"The opaque handle `create_slack_client` returned." client: string,
  @"The id of the channel to ask in." channel: string,
  @"The question posted above the buttons." prompt: string,
  @"One button label per option." options: array[string],
) -> string with prelude.throw[slack_error]

@"Low-level: listen on a channel and deliver each incoming message (channel / author / text / thread_ts /
attachments as files) to a callback. Prefer the watch_messages agent."
external agent slack_watch[effect E](
  @"The opaque handle `create_slack_client` returned." client: string,
  @"The id of the channel to listen on; messages elsewhere are ignored." channel: string,
  @"Called once per incoming message; its effects E flow to the caller's handlers." deliver_to: agent (channel: string, author: string, text: string, thread_ts: string | null, files: array[file]) -> null with E,
) -> never with E

@"Post a message to a channel using the ambient Slack client, returning the posted MESSAGE'S `ts` — the
composable seam a later edit / thread-reply agent will address a message by, so a caller that needs to
refer back keeps it (and one that does not simply drops it). Pass a message's `ts` as @thread_ts@ to
reply in its thread (an incoming message's @thread_ts@ passed straight back replies where it came
from); @files@ upload as attachments and default to none. Raises `slack_error` (`auth_error` |
`api_error`) when the send fails — catch `api_error` to keep a bot serving past a transient failure, and
let `auth_error` surface so a bad token stops the bot loudly."
agent send_message(
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text (Slack mrkdwn); with files it becomes their caption." text: string,
  @"Files to upload as the message's attachments; defaults to none." files: array[file] ?= [],
  @"The parent message's `ts` to reply in its thread; omit (or pass `null`) to post to the channel." thread_ts: string | null ?= null,
) -> string {
  slack_send(client = connection(), channel = channel, text = text, thread_ts = thread_ts, files = files)
}

@"Post RESILIENTLY, fire-and-forget — the composition every long-lived bot writes around
`send_message`, packaged: a blank @text@ with no @files@ posts nothing (a quiet protocol's silence);
a transient `api_error` (a rate limit, a channel the bot is not in) drops just this post so the bot
keeps serving; `auth_error` re-raises so a bad token still stops the bot loudly. The posted message's
`ts` is deliberately dropped — a caller that needs it wants `send_message` and its own error policy."
agent try_send(
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text; blank with no files posts nothing." text: string,
  @"Files to upload as attachments; defaults to none." files: array[file] ?= [],
  @"The parent message's `ts` to reply in its thread; omit (or pass `null`) to post to the channel." thread_ts: string | null ?= null,
) -> null {
  if (string.is_blank(value = text) && array.length(target = files) == 0) {
    null
  } else {
    use handler {
      request prelude.throw(error: slack_error) -> never {
        match (error) {
          case api_error(message => _) -> { break null }
          // The residual is exactly `auth_error` — rethrown as bound, no reconstruction.
          case rest -> { prelude.throw(error = rest) }
        }
      }
    }
    let _message_ts = send_message(channel = channel, text = text, files = files, thread_ts = thread_ts)
    null
  }
}

@"Tool: post files (images, documents) to a Slack channel, with a caption; returns the posted message's
`ts`. Use the channel id given in the conversation context; pass each file as its handle object — a bare
{\"$katari_ref\": \"<id>\"} suffices."
agent send_files(
  @"The id of the channel to post in, from the conversation context." channel: string,
  @"The files to upload, each passed as its handle object." files: array[file],
  @"The text posted alongside the files." caption: string,
) -> string {
  send_message(channel = channel, text = caption, files = files)
}

@"Serve a channel forever, delivering each incoming message to @deliver_to@ — shaped like
`time.watch` / `google_calendar.watch` so it composes under `parallel [ … ]`. The bot's own posts (and other
bots') are not delivered, so replying from @deliver_to@ cannot loop. @author@ is the sender's raw Slack
user id (an opaque `U…` id, not a name); hash it (`crypto.sha256`) before letting it leave the program,
e.g. as an AI provider's abuse-attribution tag. A delivered @thread_ts@ is the thread the message was
posted in, or `null` for a top-level message — pass it straight to `send_message` to reply where the
message came from. Delivery is at-least-once: Slack re-sends an event whose acknowledgement was lost,
and no dedup memory is kept here."
agent watch_messages[effect E](
  @"The id of the channel to listen on (e.g. \"C0123456789\")." channel: string,
  @"Called once per incoming message; its effects E flow to the caller's handlers." deliver_to: agent (channel: string, author: string, text: string, thread_ts: string | null, files: array[file]) -> null with E,
) -> never with E | connection | io {
  slack_watch(client = connection(), channel = channel, deliver_to = deliver_to)
}
