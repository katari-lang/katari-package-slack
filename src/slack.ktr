// Slack over Socket Mode: the workspace's two tokens as an ambient capability, the message plane
// (`watch_messages` in, `send_message` / `try_send` out) and the interaction plane (`ask`). The externals
// live in `slack.ts`. Every call carries the tokens it acts with, so nothing here points into the
// sidecar's memory and a watcher re-forked after a runtime restart simply connects. This is the Slack half
// of a twin contract with the `discord` package, declared in `scripts/check-twin.mjs`.

@"The Slack credentials a call acts with: the bot token (`xoxb-…`) the Web API authenticates with, and the
app-level token (`xapp-…`) the Socket Mode WebSocket opens with. Both are `string of private`, so their
taint keeps them out of anything the program prints, stores or sends onward."
data credential_data(
  @"The bot token (`xoxb-…`) every Web API call authenticates with." bot_token: string of private,
  @"The app-level token (`xapp-…`) the Socket Mode WebSocket opens with." app_token: string of private,
)

@"The ambient Slack credentials: the two tokens every call in the provider's scope acts with, resolved at
each request so a rotated token lands on the next call rather than the next restart. Performing it
connects nothing — a Socket Mode connection belongs to the call that needs events."
request credential() -> credential_data

@"Provide the Slack credentials for the extent of the continuation, resolving @bot_source@ and
@app_source@ at each `credential` request. Nothing is connected here: a Socket Mode connection belongs to
the call that needs events, which is what lets a watcher re-forked after a restart simply work. A missing
or unreadable secret raises `env.missing_secret` / `oauth.server_error` from this install site, on the
first call that needs a token; a bad token is not this agent's failure at all and surfaces as
`slack_error` from the call that used it."
agent provider[R, effect E](
  @"Where the bot token (`xoxb-…`) lives; resolved at each `credential` request." bot_source: credentials.source,
  @"Where the app-level token (`xapp-…`) lives; resolved at each `credential` request." app_source: credentials.source,
  @"Runs with `credential` served; its result is the provider's result." continuation: agent (value: null) -> R with {...E, credential},
) -> R with E | io | prelude.throw[env.missing_secret | oauth.server_error] {
  use handler {
    request credential() {
      next credential_data(
        bot_token = credentials.resolve(source = bot_source),
        app_token = credentials.resolve(source = app_source),
      )
    }
  }
  continuation(value = null)
}

@"An authentication / authorization failure: the bot token is invalid, revoked, or missing a scope the
call needs (Slack `invalid_auth`, `token_revoked`, `missing_scope`, …), or the app-level token will not
open a socket; @message@ carries Slack's error string. Only the operator can fix it, so let it surface. A
rotated token needs no restart — every call resolves the credential afresh."
data auth_error(message: string)

@"A Slack API call failed for a non-auth reason: a rate limit, a transient network fault, a channel the
bot is not in, a message too long, a Block Kit payload over one of Slack's size caps; @message@ carries
Slack's error string. Usually per-message or transient, so a bot catches it to drop just that reply and
keep serving."
data api_error(message: string)

// Raised as a `prelude.throw`, never a panic, and classified in the sidecar by Slack's error code.
type slack_error = auth_error | api_error

// ─── the message plane ────────────────────────────────────────────────────────────────────────────

@"One incoming message, as data: what arrived, where, from whom, with what attached, and in which thread.
@author@ is the sender's raw Slack user id, drawn from a workspace's small and guessable space, so a plain
digest of one is dictionary-reversible — pass it through `crypto.pseudonym` before letting it leave the
program. @thread@ passed straight back as `send_message`'s @thread_ts@ replies where the message came
from."
data message(
  @"This message's own `ts` — Slack's identity for it, the same value `send_message` returns, and the cursor `list_messages` reads after. Keep the id of the last message you handled and the gap around a restart can be closed later. (A top-level message's own `ts` is also the `thread` a reply to it would carry.)" id: string,
  @"The channel the message was posted in." channel: string,
  @"The sender's raw Slack user id (`U…`)." author: string,
  @"The message text as Slack delivered it (mrkdwn)." text: string,
  @"The message's attachments, downloaded as `file` values." files: array[file],
  @"The `ts` of the thread this message belongs to, or `null` for a top-level message." thread: string | null,
)

@"Low-level: post to a channel with @bot_token@ — a thread reply when @thread_ts@ carries a `ts`, a
channel post when it is `null`; any files upload as attachments — returning the posted message's `ts`
(or `\"\"` when Slack reports none). Pure Web API, so it opens no socket. Raises `slack_error` when the
call fails. Prefer the send_message agent."
external agent slack_send(
  @"The bot token (`xoxb-…`) to post with." bot_token: string of private,
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text (Slack mrkdwn); with files it becomes their caption." text: string,
  @"The parent message's `ts` to reply in its thread, or `null` to post to the channel." thread_ts: string | null,
  @"Files to upload as the message's attachments (`[]` for a plain text post)." files: array[file],
) -> string with prelude.throw[slack_error]

@"Low-level: read a channel's recent messages with @bot_token@ (Slack `conversations.history`). @limit@ is
clamped into 1-200 here, and the answer is reversed into posted order (Slack answers newest first).
Raises `slack_error` when the call fails. Prefer the list_messages agent."
external agent slack_history(
  @"The bot token to read with." bot_token: string of private,
  @"The channel to read." channel: string,
  @"Read only messages posted after this `ts`; empty reads the newest page." after: string,
  @"How many messages to ask Slack for; clamped into 1-200." limit: integer,
) -> array[message] with prelude.throw[slack_error]

@"Low-level: listen on a channel and deliver each incoming message to a callback. The Socket Mode
connection is opened for the extent of this call (shared with any other live call on the same
@app_token@, closed when the last one ends), and the listener is attached before it is used, so no event
arrives before something is there to receive it. Raises `slack_error` when the connection cannot be
opened — a bad app-level token is `auth_error`. Prefer the watch_messages agent."
external agent slack_watch[effect E](
  @"The bot token (`xoxb-…`) an incoming attachment downloads with." bot_token: string of private,
  @"The app-level token (`xapp-…`) the Socket Mode WebSocket opens with." app_token: string of private,
  @"The id of the channel to listen on; messages elsewhere are ignored." channel: string,
  @"Called once per incoming message; its effects E flow to the caller's handlers." deliver_to: agent (value: message) -> null with E,
) -> never with E | prelude.throw[slack_error]

@"Post a message to a channel with the ambient Slack credentials, returning the posted message's `ts` — the
handle a later edit or thread reply addresses it by. Pass a message's `ts` as @thread_ts@ to reply in its
thread (a delivered `message.thread` passed straight back replies where it came from); @files@ upload as
attachments and default to none. Raises `slack_error` when the send fails — catch `api_error` to keep a
bot serving past a transient failure, and let `auth_error` surface so a bad token stops it loudly."
agent send_message(
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text (Slack mrkdwn); with files it becomes their caption." text: string,
  @"Files to upload as the message's attachments; defaults to none." files: array[file] ?= [],
  @"The parent message's `ts` to reply in its thread; omit (or pass `null`) to post to the channel." thread_ts: string | null ?= null,
) -> string {
  let tokens = credential()
  slack_send(bot_token = tokens.bot_token, channel = channel, text = text, thread_ts = thread_ts, files = files)
}

@"A `try_send` that reached the channel: the message is posted. It carries nothing — a caller that wants
the posted message's `ts` wants `send_message` and its own error policy."
data delivered()

@"A `try_send` that posted nothing, with @reason@ saying which of the two silences it was: the transient
`api_error` this agent swallowed (a rate limit, a channel the bot is not in, a channel id that names
nothing), or a blank text with no files."
data dropped(@"Why nothing was posted, in one clause." reason: string)

// What became of one resilient post: it landed, or it did not and here is why.
type send_outcome = delivered | dropped

@"Post resiliently, fire-and-forget — the composition every long-lived bot writes around `send_message`,
packaged: a blank @text@ with no @files@ posts nothing, a transient `api_error` (a rate limit, a channel
the bot is not in) drops just this post so the bot keeps serving, and `auth_error` re-raises so a bad
token still stops the bot loudly. It answers with the outcome, so a caller reports what actually happened.
The posted message's `ts` is not carried — a caller that needs it wants `send_message`."
agent try_send(
  @"The id of the channel to post in (e.g. \"C0123456789\")." channel: string,
  @"The message text; blank with no files posts nothing." text: string,
  @"Files to upload as attachments; defaults to none." files: array[file] ?= [],
  @"The parent message's `ts` to reply in its thread; omit (or pass `null`) to post to the channel." thread_ts: string | null ?= null,
) -> send_outcome {
  if (string.trim(value = text) == "" && array.length(target = files) == 0) {
    dropped(reason = "the text was blank and no files were attached, so there was nothing to post")
  } else {
    use handler {
      request prelude.throw(error: slack_error) -> never {
        match (error) {
          case api_error(message => message) -> { break dropped(reason = f"Slack refused the post (${message})") }
          // The residual is exactly `auth_error` — rethrown as bound, no reconstruction.
          case rest -> { prelude.throw(error = rest) }
        }
      }
    }
    let _message_ts = send_message(channel = channel, text = text, files = files, thread_ts = thread_ts)
    delivered()
  }
}

@"Serve a channel forever, delivering each incoming message to @deliver_to@ as one `message` value —
shaped like `time.watch` / `google_calendar.watch` so it composes under `parallel [ … ]`. The bot's own
posts (and other bots') are not delivered, so replying from @deliver_to@ cannot loop.

Delivery is at-least-once while this call is running: Slack re-sends an event whose acknowledgement was
lost to a dropped socket, so a message can be repeated but not missed, and no dedup memory is kept here.
A message posted while the watch is down is never delivered at all, so a bot that must reconcile that gap
keeps the `id` of the last message it handled somewhere durable and closes the gap with `list_messages`.

The Socket Mode connection belongs to this call (shared with any other live watch or `ask` on the same
app-level token) and dies with it, so a runtime restart interrupts the watch under the at-most-once rule
and re-forking it is the whole of the recovery. Raises `slack_error` when the connection cannot be
opened: `auth_error` for a bad app-level token, `api_error` for a transient network fault."
agent watch_messages[effect E](
  @"The id of the channel to listen on (e.g. \"C0123456789\")." channel: string,
  @"Called once per incoming message, with the whole message as one value; its effects E flow to the caller's handlers." deliver_to: agent (value: message) -> null with E,
) -> never with E | credential | io | prelude.throw[slack_error] {
  let tokens = credential()
  slack_watch(bot_token = tokens.bot_token, app_token = tokens.app_token, channel = channel, deliver_to = deliver_to)
}

@"The gap reader: a channel's own messages posted after @after@, in posted order — the reconciliation
`watch_messages` tells you to write, since Socket Mode delivers only to a running watch. @after@ is a
message `ts`, not a wall clock: hand back the `id` of the last message you handled (kept durably — a
`var` dies with the run) and everything posted since arrives oldest first, ready for the same handling
the watch would have run. An empty @after@ reads the newest @limit@ instead, which is the shape for a
first run with no cursor yet.

The answer is the same `message` value the watch delivers, attachments downloaded into `file` values and
bot posts dropped, so one handler serves both paths — a page of image-heavy history pays for every
attachment on it, so keep @limit@ to what you will actually process. @limit@ is clamped into 1-200, so a wide gap takes
several calls, and only an empty answer means it is closed — dropped bot posts and skipped subtypes
shorten a page too. Nothing here dedups. Raises `slack_error` exactly as `send_message` does, and it
needs the `channels:history` (or `groups:history`) scope, which watching a channel does not by itself
grant."
agent list_messages(
  @"The channel to read." channel: string,
  @"The `ts` to read after — the `id` of the last message you handled. Empty reads the newest @limit@ messages instead." after: string ?= "",
  @"How many messages to ask Slack for; clamped into 1-200." limit: integer ?= 50,
) -> array[message] with credential | io | prelude.throw[slack_error] {
  let tokens = credential()
  slack_history(bot_token = tokens.bot_token, channel = channel, after = after, limit = limit)
}

// ─── the interaction plane ────────────────────────────────────────────────────────────────────────

@"A pressable button. @label@ is what the channel reads; @id@ is what comes back on `clicked`, so a
program branches on the key it chose and never on display text. An over-cap string is rejected by Slack
as `api_error`, never shortened here — see `limits`."
data button(
  @"The stable key this control answers with; matched as `clicked`'s @id@ (≤255 characters)." id: string,
  @"The button's visible text (≤75 characters). It is also what the answered message keeps in place of the controls, so write it as the line someone reads back months later." label: string,
)

@"A dropdown of fixed options: choosing one answers the ask with `chose`, carrying the option's text
verbatim, so a program may match the option itself. An over-cap string or too long an option list is
rejected by Slack as `api_error` — see `limits`."
data select(
  @"The stable key this control answers with; matched as `chose`'s @id@ (≤255 characters)." id: string,
  @"The dropdown's placeholder text, shown before anything is chosen (≤150 characters)." label: string,
  @"The options offered; the chosen one comes back verbatim (each ≤75 characters) and is what the answered message keeps in place of the dropdown." options: array[string],
)

@"One text input inside a `form`. @value@ is a prefill, which is what makes draft editing an ordinary
`ask`: ship the draft as @value@ and the human edits it in place. Every input is optional — a box left
blank comes back as the empty string, so `submitted`'s @values@ is total over the form's declared
fields."
data field(
  @"The key this field's text is stored under in `submitted`'s @values@ (≤255 characters)." id: string,
  @"The label shown above the input (≤2000 characters)." label: string,
  @"The text the input opens with — a prefill the human edits. Defaults to an empty input." value: string ?= "",
  @"A multi-line textarea instead of a single line. Defaults to single-line." multiline: boolean ?= false,
)

@"A form: a button in the channel that opens a dialog of text inputs, answering the ask with `submitted`
once the human submits it. This is how free text is collected — a one-field form asks an open question, a
prefilled multi-field form reviews a draft."
data form(
  @"The stable key this control answers with; matched as `submitted`'s @id@ (≤255 characters — it is the dialog's `callback_id` as well as the button's `action_id`)." id: string,
  @"The visible text of the button that opens the dialog (≤75 characters). It is also what the answered message keeps in place of the controls." label: string,
  @"The dialog's own heading (≤24 characters)." title: string,
  @"The inputs the dialog collects, in order." fields: array[field],
)

// The three shapes are the three ways a human answers — press, choose, write — and each has exactly one
// matching `answer` constructor.
type control = button | select | form

@"A `button` was pressed: @id@ is that button's own id, @by@ the Slack user id of whoever pressed it."
data clicked(
  @"The `button`'s @id@." id: string,
  @"The answerer's raw Slack user id (`U…`)." by: string,
)

@"A `select`'s option was chosen: @id@ is that select's own id and @option@ the chosen text verbatim."
data chose(
  @"The `select`'s @id@." id: string,
  @"The chosen option, exactly as it was offered." option: string,
  @"The answerer's raw Slack user id (`U…`)." by: string,
)

@"A `form` was submitted: @id@ is that form's own id and @values@ maps each `field`'s id to the text the
human left in it (`record.get` reads one). A box left blank is present as the empty string, so @values@ is
total over the form's declared fields — a missing key means the field was never declared, not that it went
unanswered. A submit means \"approved at these values\", so acting on @values@ acts on exactly what the
human read and sent."
data submitted(
  @"The `form`'s @id@." id: string,
  @"Each `field`'s id to the text submitted for it; a blank box is the empty string." values: record[string],
  @"The answerer's raw Slack user id (`U…`)." by: string,
)

// One constructor per `control` shape, so matching the answer is the same dispatch as choosing the control.
type answer = clicked | chose | submitted

@"Post @prompt@ with @controls@ under it and block until someone in the channel answers, returning the
`answer` that control produced. It is the one interaction primitive, so the four human-in-the-loop shapes
are four control lists rather than four agents: an approval is two `button`s, an open question a one-field
`form`, a draft review a `form` whose `field` is prefilled with the draft, and a multiple choice a
`select`. Every control is live at once and the first answer settles the ask; the controls are then
stripped from the message, so a second answer has nothing to press. Branch on the control's own id —
`case clicked(id => \"approve\", by => _)` — never on display text.

The channel's membership is the trust boundary: any member may answer, and @by@ on the answer is the
answerer's raw Slack user id, so pass it through `crypto.pseudonym` before letting it leave the program.
Opening a `form`'s dialog and closing it again is not an answer, so a curious press cannot consume the
ask. A `form`'s inputs are not validated at all, and cannot be: the socket acknowledges every interaction
the instant it arrives, which is exactly what closes the dialog, so per-field errors can never be
returned. Validate in the program and `ask` again.

The ask holds no time limit: a deadline is `time.with_deadline` wrapped around it, a withdrawal is
`region.cancel_by_id` on the fiber holding it. Every ending takes the controls off, best-effort and
fire-and-forget — an answer leaves its own outcome line, a cancel or expired deadline leaves `(expired)`,
a question the platform broke leaves `(failed)`. One ending cannot: a runtime restart interrupts the call
under the at-most-once rule and takes the prompt's identity with it, so let the panic ride to your
supervisor and ask again.

Nothing here is clamped: a string past one of the numbers `limits` publishes is Slack's rejection arriving
as a typed `api_error`, and a form's own caps show when its dialog opens rather than when the question
posts. Run `check_controls` where the controls are built — it is deliberately not wired in here, since
`ask` returns an `answer` with no room for a verdict and what a failed check means is the caller's
decision. A control portable to the Discord twin takes the tighter of the two platforms' numbers: a
≤24-character title, ≤45-character field labels, ≤75-character button labels and options. Raises
`slack_error` when a Slack call fails; catch `api_error` to ask again."
agent ask(
  @"The id of the channel to ask in — its membership is who may answer." channel: string,
  @"The question posted above the controls (Slack mrkdwn)." prompt: string,
  @"What the human may answer with: `button` / `select` / `form` values, rendered in one row in order. Each control's @id@ must be distinct within one ask — the id is the correlation key Slack carries back, so a repeat would make two controls indistinguishable." controls: array[control],
) -> answer with credential | io | prelude.throw[slack_error] {
  let tokens = credential()
  slack_ask(bot_token = tokens.bot_token, app_token = tokens.app_token, channel = channel, prompt = prompt, controls = controls)
}

@"Low-level: post a prompt with its controls and await the first answer. The Socket Mode connection the
answer arrives over is opened for the extent of this call (shared with any other live call on the same
@app_token@, closed when the last one ends), and the question posts only once it is up. Prefer the ask
agent."
external agent slack_ask(
  @"The bot token (`xoxb-…`) the question posts with." bot_token: string of private,
  @"The app-level token (`xapp-…`) the answer arrives over." app_token: string of private,
  @"The id of the channel to ask in." channel: string,
  @"The question posted above the controls." prompt: string,
  @"The controls offered under the prompt." controls: array[control],
) -> answer with prelude.throw[slack_error]

// ─── the platform's numbers, and a local check against them ───────────────────────────────────────
//
// Slack enforces every cap itself and this package clamps nothing, so `limits` publishes the numbers as
// data and `check_controls` reads them — both pure, so a question is checked where its controls are built
// rather than when it posts. Each number is cited on the `caps` field that carries it (Slack's own
// reference, read 2026-07-29); one that moves at Slack moves here by hand.

@"Slack's limits on what one question may present, as data — the numbers Slack refuses a payload against,
published so a program can read them instead of rediscovering them from a rejected post. Every one is
fatal past it, and blank is fatal too, since a Block Kit `plain_text` object takes at least one character;
nothing here shortens anything. Lengths are in characters, and Slack's own counting is unspecified, so a
string within a couple of characters of its cap should be shortened rather than argued about."
data caps(
  @"One message's text as this package posts it: at most this many characters. It is the cap on an `ask`'s @prompt@ — a question posts as a section block, and Slack refuses a block over this — and the number a portable program bounds all its text against. `send_message` / `try_send`'s @text@ has a laxer cap of its own, @post_text@. Source: section block, `text` max 3000." message_text: integer,
  @"`send_message` / `try_send`'s @text@ alone: Slack truncates a message past this many characters rather than refusing it — the one cap here that is not fatal. Source: chat.postMessage, `text` truncated past 40000." post_text: integer,
  @"A `button`'s @label@ — and a `form`'s opening button's: at most this many characters, and at least one. Source: button element, `text` max 75." button_label: integer,
  @"A `select`'s @label@, the placeholder line: at most this many characters, and at least one. The placeholder is always rendered, so blank is not legal. Source: select menu element, `placeholder` max 150." select_label: integer,
  @"Each of a `select`'s @options@: 1 to this many characters — the option's text is the answer. The same string is also sent as the option's `value` (cap 150), so the tighter of the two binds. Source: option object, `text` max 75." select_option: integer,
  @"How many @options@ one `select` may offer: 1 to this many. Source: select menu element, `options` max 100." select_options: integer,
  @"A `form`'s @title@: at most this many characters. It is the tightest number on either platform, which is why the twin contract asks every portable form to fit it. Source: modal view, `title` max 24." form_title: integer,
  @"How many `field` boxes one `form`'s dialog may hold: 1 to this many. Each box is one input block and this package adds no other blocks to the dialog, so the view's block cap is the box cap. Source: modal view, `blocks` max 100." form_fields: integer,
  @"A `field`'s @label@: at most this many characters, and at least one. Source: input block, `label` max 2000." field_label: integer,
  @"A `field`'s @value@, the prefilled draft: at most this many characters. Blank is legal — it is the absence of a prefill. Derived rather than cited: `initial_value` is documented with no cap, but a plain-text input's own content bound is 3000, so a longer prefill cannot survive the box it is put in. Source: plain-text input element, `max_length` 1–3000." field_value: integer,
  @"A `button`'s, `select`'s or `field`'s @id@: 1 to this many characters — it is the `action_id` Slack routes the answer back by, never presentation. Source: button / select menu / plain-text input elements, `action_id` max 255." control_id: integer,
  @"A `form`'s @id@: 1 to this many characters — it rides as both the opening button's `action_id` and the dialog's `callback_id`, and Slack caps them alike. Source: modal view, `callback_id` max 255." form_id: integer,
  @"How many rows of controls one message may carry. It is 1: this package renders every control into one actions block, so @buttons_per_row@ is the whole budget. Source: this package's renderer (`promptBlocks`), bounded by the actions block below." rows: integer,
  @"How many controls that one row holds — the actions block's element cap. A dropdown takes no row of its own here, so the layout rule is simply this many controls in total. Source: actions block, `elements` max 25." buttons_per_row: integer,
)

@"Slack's caps, as one `caps` value — pure, so it costs nothing and composes anywhere (a gate builder, a
test, an error message that wants to say what the bound was). Every number is cited on the `caps` field
that carries it."
agent limits() -> caps {
  caps(
    message_text = 3000,
    post_text = 40000,
    button_label = 75,
    select_label = 150,
    select_option = 75,
    select_options = 100,
    form_title = 24,
    form_fields = 100,
    field_label = 2000,
    field_value = 3000,
    control_id = 255,
    form_id = 255,
    rows = 1,
    buttons_per_row = 25,
  )
}

@"The controls are askable exactly as written: every string fits, every count fits, and every id is
distinct."
data valid()

@"Something about the controls will not reach the channel as written, and @reason@ names which control and
what in one line — the first problem found, in declaration order, so a fix at a time converges."
data invalid(@"Which control, and what is wrong with it." reason: string)

// The verdict: askable as written, or the first reason it is not.
type control_check = valid | invalid

@"Check @controls@ against Slack's caps locally and answer with a value — `valid`, or `invalid` carrying
one sentence naming the offending control. Pure: no connection, no io, nothing to catch, so it belongs
where the controls are built (a gate's constructor, a test) rather than where they are asked. It is
deliberately not wired into `ask`, which returns an `answer` with no room for a verdict; a caller must be
free to decide what a failed check means.

It reports every string blank or past its cap in `limits`, every count (including an empty @controls@,
which Slack posts happily as a bare prompt that nobody can ever answer, so the ask waits forever), and
duplicate ids — two controls sharing an `action_id` cannot be told apart on the way back, so a press on
one would answer as the other, and a `form`'s @fields@ are checked the same way, since `submitted.values`
is keyed by field id."
agent check_controls(
  @"The controls one `ask` would present, in the order it would render them." controls: array[control],
) -> control_check {
  let cap = limits()

  // Slack refuses rather than repairs, so blank is as fatal as over-long (an empty `plain_text` is
  // rejected) and nothing is substituted.
  agent fatal_string(where: string, what: string, value: string, allowed: integer) -> string {
    if (value == "") {
      f"${where}: ${what} is blank, which Slack rejects as api_error"
    } else if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Slack takes ${allowed}, which it rejects as api_error"
    } else {
      ""
    }
  }

  // A `field`'s prefill: empty means "no draft" and is omitted from the payload, but over-long is fatal
  // — a draft docked to fit would be approved as though it were whole.
  agent optional_text(where: string, what: string, value: string, allowed: integer) -> string {
    if (string.length(value = value) > allowed) {
      f"${where}: ${what} is ${string.length(value = value)} characters where Slack takes ${allowed}, which it rejects as api_error"
    } else {
      ""
    }
  }

  // "" is how every check above spells "nothing wrong"; first in declaration order wins, so a caller
  // fixes one thing at a time.
  agent first_problem(problems: array[string]) -> string {
    for (let problem in problems, var found: string = "") {
      if (found == "" && problem != "") {
        next with { found = problem }
      } else {
        next
      }
    } then (_problems) {
      found
    }
  }

  agent id_of(control: control) -> string {
    match (control) {
      case button(id => id) -> id
      case select(id => id) -> id
      case form(id => id) -> id
    }
  }

  // The position is stated even where there is an id, because two controls may share one — which is
  // itself among the things reported.
  agent where_of(index: integer, id: string) -> string {
    if (id == "") {
      f"control #${index + 1}"
    } else {
      f"control #${index + 1} (\"${id}\")"
    }
  }

  // Laid out exactly as the renderer lays them out: every control is one element of one actions block, so
  // they pack `buttons_per_row` to a row and a `select` takes no row of its own.
  agent rows_used(controls: array[control]) -> integer {
    for (let _control in controls, var rows: integer = 0, var pending: integer = 0) {
      if (pending == cap.buttons_per_row) {
        next with { rows = rows + 1, pending = 1 }
      } else {
        next with { pending = pending + 1 }
      }
    } then (_controls) {
      if (pending > 0) {
        rows + 1
      } else {
        rows
      }
    }
  }

  agent options_problem(where: string, options: array[string]) -> string {
    let count = array.length(target = options)
    if (count == 0) {
      f"${where}: the dropdown offers no options; Slack takes 1 to ${cap.select_options}"
    } else if (count > cap.select_options) {
      f"${where}: the dropdown offers ${count} options; Slack takes 1 to ${cap.select_options}"
    } else {
      for (let option in options, var at: integer = 0, var found: string = "") {
        let problem = fatal_string(where = where, what = f"option #${at + 1}", value = option, allowed = cap.select_option)
        if (found == "" && problem != "") {
          next with { at = at + 1, found = problem }
        } else {
          next with { at = at + 1 }
        }
      } then (_options) {
        found
      }
    }
  }

  // The box ids must be distinct: `submitted.values` is keyed by field id, so two boxes sharing one come
  // back as a single entry and the other box's text is simply gone.
  agent fields_problem(where: string, fields: array[field]) -> string {
    let count = array.length(target = fields)
    if (count == 0) {
      f"${where}: the dialog has no boxes; Slack takes 1 to ${cap.form_fields}"
    } else if (count > cap.form_fields) {
      f"${where}: the dialog has ${count} boxes; Slack takes 1 to ${cap.form_fields}"
    } else {
      for (let box in fields, var at: integer = 0, var seen: record[boolean] = {}, var found: string = "") {
        let what = f"box #${at + 1}"
        let duplicate = if (box.id != "" && record.has(target = seen, key = box.id)) {
          f"${where}: ${what} repeats the field id \"${box.id}\", so both boxes would come back as one entry of submitted.values"
        } else {
          ""
        }
        let problem = first_problem(problems = [
          fatal_string(where = where, what = f"${what}'s id", value = box.id, allowed = cap.control_id),
          duplicate,
          fatal_string(where = where, what = f"${what}'s label", value = box.label, allowed = cap.field_label),
          optional_text(where = where, what = f"${what}'s prefill", value = box.value, allowed = cap.field_value),
        ])
        if (found == "" && problem != "") {
          next with { at = at + 1, seen = record.set(target = seen, key = box.id, value = true), found = problem }
        } else {
          next with { at = at + 1, seen = record.set(target = seen, key = box.id, value = true) }
        }
      } then (_fields) {
        found
      }
    }
  }

  // The id is checked first: it decides whether the control can be routed at all.
  agent control_problem(where: string, control: control) -> string {
    match (control) {
      case button(id => id, label => label) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.control_id),
        fatal_string(where = where, what = "the button's label", value = label, allowed = cap.button_label),
      ])
      case select(id => id, label => label, options => options) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.control_id),
        fatal_string(where = where, what = "the dropdown's placeholder", value = label, allowed = cap.select_label),
        options_problem(where = where, options = options),
      ])
      case form(id => id, label => label, title => title, fields => fields) -> first_problem(problems = [
        fatal_string(where = where, what = "the id", value = id, allowed = cap.form_id),
        fatal_string(where = where, what = "the opening button's label", value = label, allowed = cap.button_label),
        fatal_string(where = where, what = "the dialog's title", value = title, allowed = cap.form_title),
        fields_problem(where = where, fields = fields),
      ])
    }
  }

  if (array.length(target = controls) == 0) {
    invalid(reason = "no controls: Slack posts the prompt happily and the question can never be answered")
  } else {
    for (let control in controls, var at: integer = 0, var seen: record[boolean] = {}, var found: string = "") {
      let id = id_of(control = control)
      let where = where_of(index = at, id = id)
      // A blank id is reported by `control_problem` as the fatal thing it is, so it is not also reported
      // as a duplicate of the previous blank one.
      let duplicate = if (id != "" && record.has(target = seen, key = id)) {
        f"${where}: two controls share this id, and Slack carries back nothing else — a press on either would answer as the first"
      } else {
        ""
      }
      let problem = first_problem(problems = [duplicate, control_problem(where = where, control = control)])
      if (found == "" && problem != "") {
        next with { at = at + 1, seen = record.set(target = seen, key = id, value = true), found = problem }
      } else {
        next with { at = at + 1, seen = record.set(target = seen, key = id, value = true) }
      }
    } then (_controls) {
      if (found != "") {
        invalid(reason = found)
      } else if (rows_used(controls = controls) > cap.rows) {
        invalid(reason = f"the controls need ${rows_used(controls = controls)} rows and Slack fits ${cap.rows} on this package's prompt: every control is one element of a single actions block, which holds ${cap.buttons_per_row}")
      } else {
        valid()
      }
    }
  }
}
